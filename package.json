    "autoprefixer": "^10.5.2",
    "gh-pages": "^6.3.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.116.0"
  }
}
